# ================================
# AISLE - Environment Variables
# ================================
# Copy to .env and fill in real values:
#   cp .env.example .env

# ------- Required -------

# Neon Postgres (free tier): https://console.neon.tech
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# Razorpay test mode only: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Any long random string (generate with: openssl rand -hex 32)
JWT_SECRET=change_me_use_openssl_rand_hex_32

# ------- LLM (Agent Brain + reasoning traces) -------
# Razorpay Buildathon: Anthropic is recommended. Groq also works.
# auto = Anthropic if ANTHROPIC_API_KEY is set, otherwise Groq
LLM_PROVIDER=auto

# Anthropic (recommended): https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional model override (default: claude-sonnet-4-20250514)
# ANTHROPIC_AGENT_MODEL=claude-sonnet-4-20250514

# Groq (optional): https://console.groq.com/keys
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_AGENT_MODEL=openai/gpt-oss-20b

# ------- Optional -------

# Webhook secret if you configure Razorpay webhooks → POST /v1/webhooks/razorpay
# RAZORPAY_WEBHOOK_SECRET=whsec_xxxx

# After Orders API create, also run payment.captured settle path
# (default: on when NODE_ENV is not production)
# AISLE_DEMO_AUTO_SETTLE=true

# Absolute API URL for agent jobs (usually unset locally)
# AISLE_API_URL=http://localhost:3001/v1

# ------- App -------
PORT=3001
NODE_ENV=development
DASHBOARD_URL=http://localhost:5173
